{
  "description": "「吃什么」微信小程序 —— 看看大家今天真的吃了什么",
  "compileType": "miniprogram",
  "cloudfunctionRoot": "cloudfunctions/",
  "libVersion": "3.5.5",
  "appid": "touristappid",
  "projectname": "chishenme",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tools"
      },
      {
        "type": "folder",
        "value": "preview"
      },
      {
        "type": "suffix",
        "value": ".md"
      }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "coverView": true,
    "nodeModules": false,
    "autoAudits": false,
    "showShadowRootInWxmlPanel": true,
    "scopeDataCheck": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "uploadWithSourceMap": true,
    "compileHotReLoad": false,
    "useMultiFrameRuntime": true,
    "useApiHook": true,
    "useApiHostProcess": true,
    "useIsolateContext": true,
    "packNpmManually": false,
    "minifyWXSS": true,
    "minifyWXML": true,
    "disableUseStrict": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {
    "miniprogram": {
      "list": [
        {
          "name": "首页",
          "pathName": "pages/index/index",
          "query": "",
          "scene": null
        },
        {
          "name": "记一顿",
          "pathName": "pages/record/record",
          "query": "",
          "scene": null
        },
        {
          "name": "我的",
          "pathName": "pages/mine/mine",
          "query": "",
          "scene": null
        }
      ]
    }
  }
}
