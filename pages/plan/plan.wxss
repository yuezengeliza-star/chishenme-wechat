.plan-seg {
  margin-top: 28rpx;
}

.plan-date {
  font-size: 24rpx;
  color: var(--text2);
  margin: 24rpx 0 16rpx 8rpx;
}

.plan-slot-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
}

.plan-slot-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.plan-slot-card__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan-slot-card__emoji {
  font-size: 30rpx;
}

.plan-slot-card__label {
  font-size: 27rpx;
  color: var(--text2);
}

.plan-slot-card__body {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.plan-slot-card__thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.plan-slot-card__name {
  font-size: 32rpx;
  font-weight: 500;
}

.plan-slot-card__sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.plan-slot-card__source {
  font-size: 22rpx;
  color: var(--text2);
  background: #F6F1EC;
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
}

.plan-slot-card__ref {
  font-size: 22rpx;
  color: var(--text3);
}

.plan-slot-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.plan-slot-card__done {
  font-size: 22rpx;
  color: #5C7A52;
  margin-top: 18rpx;
}

.plan-slot-card__empty {
  font-size: 26rpx;
  color: var(--text3);
  margin-bottom: 20rpx;
}

.plan-slot-card__quick {
  display: flex;
  gap: 16rpx;
}

.quick-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--apricot-soft);
  color: var(--primary);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.quick-btn__emoji {
  font-size: 26rpx;
}

.plan-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx;
}

.plan-foot__text {
  font-size: 26rpx;
  color: var(--primary);
}

.plan-tip {
  font-size: 21rpx;
  color: var(--text3);
  line-height: 1.75;
  margin: 28rpx 8rpx 0;
}
