.rd__hero {
  text-align: center;
  padding: 40rpx 0 32rpx;
}

.rd__dog {
  width: 200rpx;
  height: 200rpx;
}

.rd__hero-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.rd__hero-sub {
  font-size: 24rpx;
  color: var(--text2);
  margin-top: 10rpx;
}

.rd__source {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.rd__source-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--apricot-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.rd__source-title {
  font-size: 31rpx;
  font-weight: 500;
}

.rd__source-desc {
  font-size: 22rpx;
  color: var(--text2);
  margin-top: 8rpx;
  line-height: 1.6;
}

/* 抽奖态 */
.rd__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 4rpx;
}

.rd__back {
  font-size: 26rpx;
  color: var(--text2);
}

.rd__source-name {
  font-size: 24rpx;
  color: var(--text2);
}

.rd__tabs {
  margin-top: 20rpx;
  background: #F6F1EC;
  border-radius: 999rpx;
  padding: 6rpx;
}

.rd__card {
  margin-top: 28rpx;
  padding: 28rpx;
}

.rd__media {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rd__media-emoji {
  font-size: 140rpx;
  line-height: 1;
}

.rd__name {
  font-size: 40rpx;
  font-weight: 600;
  margin-top: 28rpx;
}

.rd__amount {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary);
  margin-top: 10rpx;
}

.rd__amount-none {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text3);
}

.rd__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--divider);
}

.rd__avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.rd__author {
  font-size: 28rpx;
  font-weight: 500;
}

.rd__time {
  font-size: 22rpx;
  color: var(--text2);
  margin-top: 4rpx;
}

.rd__more {
  font-size: 24rpx;
  color: var(--primary);
}

.rd__plan {
  margin-top: 30rpx;
}

.rd__again {
  text-align: center;
  font-size: 28rpx;
  color: var(--text2);
  padding: 26rpx 0 4rpx;
}

.rd__rolling {
  text-align: center;
  padding: 80rpx 0;
}

.rd__rolling .rd__dog {
  width: 180rpx;
  height: 180rpx;
}
