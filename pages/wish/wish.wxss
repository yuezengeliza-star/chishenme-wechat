.wish-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary);
  color: #fff;
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.wish-add__plus {
  font-size: 36rpx;
  line-height: 1;
}

.wish-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 40rpx;
}

.wish-head__title {
  font-size: 32rpx;
  font-weight: 600;
}

.wish-head__count {
  font-size: 22rpx;
  color: var(--text3);
}

.wish-head__desc {
  font-size: 22rpx;
  color: var(--text2);
  margin-top: 10rpx;
  line-height: 1.7;
}

.wish {
  margin-top: 22rpx;
  padding: 24rpx;
}

.wish__main {
  display: flex;
  gap: 20rpx;
}

.wish__thumb {
  width: 132rpx;
  height: 132rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  flex-shrink: 0;
}

.wish__name {
  font-size: 32rpx;
  font-weight: 500;
}

.wish__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.wish__place {
  font-size: 23rpx;
  color: var(--text2);
}

.wish__amount {
  font-size: 23rpx;
  color: var(--primary);
}

.wish__note {
  font-size: 22rpx;
  color: var(--text2);
  margin-top: 8rpx;
  line-height: 1.6;
}

.wish__source {
  display: inline-block;
  font-size: 21rpx;
  color: var(--text3);
  margin-top: 10rpx;
}

.wish__source--own {
  color: var(--text3);
}

.wish__actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--divider);
}

.wish__link {
  font-size: 24rpx;
  color: var(--text2);
}

.wish__link--danger {
  color: var(--coral);
}
