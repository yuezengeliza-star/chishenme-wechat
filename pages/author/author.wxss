.au {
  margin-top: 28rpx;
  padding: 32rpx 28rpx;
}

.au__top {
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.au__avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.au__info {
  min-width: 0;
}

.au__name {
  font-size: 38rpx;
  font-weight: 600;
}

.au__row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
}

.au__count {
  font-size: 22rpx;
  color: var(--text2);
}

.au__bio {
  font-size: 23rpx;
  color: var(--text2);
  margin-top: 12rpx;
  line-height: 1.6;
}

.au__follow {
  margin-top: 30rpx;
}

.au__self {
  margin-top: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--sage-soft);
  color: #5C7A52;
  text-align: center;
  font-size: 28rpx;
}

.au__hint {
  font-size: 21rpx;
  color: var(--text3);
  text-align: center;
  margin-top: 16rpx;
}

.au__hint--muted {
  color: var(--text3);
}

/* 今天吃了什么 */
.au__today {
  padding: 0 24rpx;
}

.au__today-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.au__today-row:last-child {
  border-bottom: none;
}

.au__today-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.au__today-emoji {
  font-size: 30rpx;
}

.au__today-label {
  font-size: 26rpx;
  color: var(--text2);
}

.au__today-right {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.au__today-name {
  font-size: 29rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 300rpx;
}

.au__today-amount {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.au__today-amount--none {
  font-size: 22rpx;
  color: var(--text3);
  font-weight: 400;
}

.au__today-none {
  font-size: 25rpx;
  color: var(--text3);
}

.au__foot {
  font-size: 21rpx;
  color: var(--text3);
  text-align: center;
  margin: 44rpx 8rpx 20rpx;
  line-height: 1.7;
}
