.detail {
  padding-bottom: 220rpx;
}

/* 1. 大图 */
.detail__hero {
  margin: 24rpx 0 0;
  width: 100%;
  height: 560rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: var(--apricot-soft);
}

.detail__hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.detail__hero--ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail__hero-emoji {
  font-size: 200rpx;
  line-height: 1;
}

/* 2. 饭名 + 金额 */
.detail__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 36rpx;
}

.detail__name {
  font-size: 44rpx;
  font-weight: 600;
  flex: 1;
  margin-right: 20rpx;
}

.detail__amount {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary);
  flex-shrink: 0;
}

.detail__amount--unknown {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text3);
}

.detail__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.detail__meta-time {
  font-size: 24rpx;
  color: var(--text2);
}

/* 3. 作者 */
.detail__author {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 36rpx;
}

.detail__author-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.detail__author-name {
  font-size: 32rpx;
  font-weight: 600;
}

.detail__author-sub {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 8rpx;
}

.detail__author-count {
  font-size: 22rpx;
  color: var(--text2);
}

/* 4 / 5. 地点与感受 */
.detail__block {
  margin-top: 28rpx;
  padding: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--divider);
  border-radius: 24rpx;
}

.detail__block--empty {
  background: transparent;
  border-style: dashed;
}

.detail__block-title {
  font-size: 25rpx;
  color: var(--text2);
  margin-bottom: 14rpx;
}

.detail__block-body {
  font-size: 30rpx;
  line-height: 1.7;
}

.detail__block-body--mood {
  color: #5A463A;
}

.detail__block-body--muted {
  font-size: 25rpx;
  color: var(--text3);
  line-height: 1.7;
}

.detail__block-note {
  font-size: 22rpx;
  color: var(--text3);
  margin-top: 12rpx;
}

.detail__foot-tip {
  font-size: 21rpx;
  color: var(--text3);
  text-align: center;
  margin: 36rpx 8rpx 12rpx;
  line-height: 1.7;
}

/* 6. 底部操作 */
.detail__save {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 1rpx solid var(--divider);
  background: var(--card);
}

.detail__save-icon {
  font-size: 30rpx;
  color: var(--text2);
  line-height: 1;
}

.detail__save-text {
  font-size: 20rpx;
  color: var(--text2);
  margin-top: 4rpx;
}

.detail__save--on {
  background: var(--apricot-soft);
  border-color: var(--apricot);
}

.detail__save--on .detail__save-icon,
.detail__save--on .detail__save-text {
  color: var(--primary);
}

.detail__mine {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail__mine-time {
  font-size: 24rpx;
  color: var(--text2);
}

/* 删除入口：轻量文字按钮，不抢主操作的注意力 */
.detail__del {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--text2);
  border: 1rpx solid var(--divider);
  border-radius: 999rpx;
  background: var(--card);
}

.detail__del:active {
  color: #c0392b;
  border-color: #c0392b;
  background: #fdf3f2;
}

/* 就吃这个的餐次选择样式在 app.wxss 中统一维护 */
