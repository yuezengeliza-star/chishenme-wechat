.we__tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #8A4A17;
  line-height: 1.7;
}

.we__amount {
  display: flex;
  align-items: center;
  height: 92rpx;
  background: var(--card);
  border: 1rpx solid var(--divider);
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.we__amount-sign {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 600;
  margin-right: 10rpx;
}

.we__amount-input {
  flex: 1;
  font-size: 30rpx;
  height: 100%;
}

.we__images {
  display: flex;
  gap: 20rpx;
}
