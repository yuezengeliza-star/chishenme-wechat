/* ===================================================================
   「吃什么」全局样式 / 设计令牌
   视觉基准：奶油杏橙 —— 奶油白占大面积，杏橙只点亮关键动作
   =================================================================== */

page {
  /* 色板 */
  --primary: #FF8B3D;
  --primary-soft: #FFF1E5;
  --bg: #FFF8F1;
  --card: #FFFFFF;
  --apricot: #FFD8B5;
  --apricot-soft: #FFEFE1;
  --sage: #A8C79D;
  --sage-soft: #EEF5EA;
  --text: #49352A;
  --text2: #8B7B72;
  --text3: #B9ACA3;
  --divider: #EFE5DC;
  --coral: #F59A86;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view, image, navigator {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding: 0 32rpx calc(180rpx + env(safe-area-inset-bottom));
}

.page--flat {
  padding-bottom: 40rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow {
  flex: 1;
  min-width: 0;
}

/* ---------- 文字 ---------- */
.t-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.t-sub {
  font-size: 24rpx;
  color: var(--text2);
}

.t-hint {
  font-size: 24rpx;
  color: var(--text3);
}

.t-em {
  font-size: 34rpx;
  font-weight: 600;
}

.t-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
}

.t-price--lg {
  font-size: 40rpx;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-center {
  text-align: center;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--divider);
}

.card--soft {
  background: var(--apricot-soft);
  border-color: transparent;
}

.card--flat {
  border: none;
  padding: 0;
}

.section {
  margin-top: 40rpx;
}

.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
}

.section__more {
  font-size: 24rpx;
  color: var(--text2);
}

.divider {
  height: 1rpx;
  background: var(--divider);
}

/* ---------- 按钮 ---------- */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  padding: 0 40rpx;
  border: none;
}

.btn--primary {
  background: var(--primary);
  color: #fff;
}

.btn--primary-hover {
  background: #F07C2E;
}

.btn--ghost {
  background: transparent;
  color: var(--text2);
  border: 1rpx solid var(--divider);
}

.btn--soft {
  background: var(--apricot-soft);
  color: var(--primary);
}

.btn--sage {
  background: var(--sage);
  color: #fff;
}

.btn--block {
  width: 100%;
  display: block;
}

.btn--disabled {
  opacity: 0.45;
}

.btn--sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 28rpx;
}

/* 底部固定操作条 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 248, 241, 0.94);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--divider);
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 30;
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 32rpx;
}

.field__label {
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 14rpx;
}

.input {
  width: 100%;
  height: 92rpx;
  background: var(--card);
  border: 1rpx solid var(--divider);
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--text);
}

.input--area {
  height: auto;
  min-height: 176rpx;
  padding: 24rpx 28rpx;
  line-height: 1.6;
}

.input__ph {
  color: var(--text3);
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--text3);
  margin-top: 8rpx;
}

/* ---------- 头像 ---------- */
.avatar {
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 600;
  overflow: hidden;
}

.avatar--xs {
  width: 40rpx;
  height: 40rpx;
  font-size: 20rpx;
}

.avatar--sm {
  width: 56rpx;
  height: 56rpx;
  font-size: 24rpx;
}

.avatar--md {
  width: 80rpx;
  height: 80rpx;
  font-size: 32rpx;
}

.avatar--lg {
  width: 128rpx;
  height: 128rpx;
  font-size: 48rpx;
}

.avatar--xl {
  width: 160rpx;
  height: 160rpx;
  font-size: 60rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag--apricot {
  background: var(--apricot);
  color: #8A4A17;
}

.tag--soft {
  background: var(--apricot-soft);
  color: var(--primary);
}

.tag--sage {
  background: var(--sage-soft);
  color: #5C7A52;
}

.tag--plain {
  background: #F6F1EC;
  color: var(--text2);
}

/* 等级徽章 */
.level {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--apricot-soft);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* ---------- 双列饭卡网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid__item {
  width: 336rpx;
  margin-bottom: 24rpx;
}

/* ---------- 食物占位图（无图饭记统一视觉） ---------- */
.media {
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--apricot-soft);
  position: relative;
}

.media__img {
  width: 100%;
  height: 100%;
  display: block;
}

.media__ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(150deg, #FFEFE1 0%, #FFE2C9 100%);
}

.media__emoji {
  font-size: 72rpx;
  line-height: 1;
}

/* ---------- 餐次切换 ---------- */
.meal-tabs {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.meal-tab {
  flex: 1;
  text-align: center;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  color: var(--text2);
  background: transparent;
}

.meal-tab--on {
  background: var(--primary);
  color: #fff;
  font-weight: 500;
}

/* ---------- 分段控制 ---------- */
.segment {
  display: flex;
  background: #F6F1EC;
  border-radius: 999rpx;
  padding: 6rpx;
}

.segment__item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--text2);
  border-radius: 999rpx;
}

.segment__item--on {
  background: var(--card);
  color: var(--primary);
  font-weight: 500;
}

/* ---------- 列表行 ---------- */
.list-cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.list-cell:last-child {
  border-bottom: none;
}

.cell-arrow {
  color: var(--text3);
  font-size: 26rpx;
  margin-left: 8rpx;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty__img {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 20rpx;
  opacity: 0.95;
}

.empty__text {
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 28rpx;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(73, 53, 42, 0.42);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 80vh;
}

.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 8rpx;
}

.sheet__desc {
  font-size: 24rpx;
  color: var(--text2);
  text-align: center;
  margin-bottom: 28rpx;
}

.sheet__close {
  text-align: center;
  color: var(--text2);
  font-size: 28rpx;
  padding: 28rpx 0 4rpx;
}

/* ---------- 选项胶囊（可见范围 / 餐次安排通用） ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #F6F1EC;
  color: var(--text2);
  font-size: 26rpx;
  border: 1rpx solid transparent;
}

.chip--on {
  background: var(--primary-soft);
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 500;
}

.chip--block {
  flex: 1;
  text-align: center;
  padding: 0 12rpx;
}

/* ---------- 选择行（日期 / 时间 / 地点） ---------- */
.pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 8rpx;
  border-bottom: 1rpx solid var(--divider);
}

.pick-row__k {
  font-size: 28rpx;
  color: var(--text2);
}

.pick-row__v {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

/* ---------- 就吃这个 / 安排到餐单：餐次选择 ---------- */
.plan-group {
  margin-bottom: 28rpx;
}

.plan-group__label {
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 16rpx;
}

.plan-slots {
  display: flex;
  gap: 16rpx;
}

.plan-slot {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 20rpx;
  border: 1rpx solid var(--divider);
  text-align: center;
  background: var(--card);
}

.plan-slot--taken {
  border-color: var(--sage);
  background: var(--sage-soft);
}

.plan-slot__emoji {
  display: block;
  font-size: 38rpx;
  line-height: 1.2;
}

.plan-slot__label {
  display: block;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.plan-slot__taken {
  display: block;
  font-size: 20rpx;
  color: #5C7A52;
  margin-top: 4rpx;
}

.card--hover {
  transform: scale(0.985);
  transition: transform 160ms ease;
}

/* ---------- 图片选择（记一顿 / 我的想吃共用） ---------- */
.rec-images {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.rec-img {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--card);
  border: 1rpx solid var(--divider);
}

.rec-img__pic {
  width: 100%;
  height: 100%;
  display: block;
}

.rec-img__del {
  position: absolute;
  right: 0;
  top: 0;
  width: 46rpx;
  height: 46rpx;
  background: rgba(73, 53, 42, 0.55);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 20rpx;
}

.rec-img--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--apricot-soft);
  border: 1rpx dashed var(--apricot);
}

.rec-img__plus {
  font-size: 46rpx;
  color: var(--primary);
  line-height: 1;
}

.rec-img__label {
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 10rpx;
}

.rec-img__opt {
  font-size: 20rpx;
  color: var(--text3);
  margin-top: 4rpx;
}

.rec-hint-inline {
  font-size: 21rpx;
  color: var(--text3);
  margin-top: 12rpx;
  line-height: 1.6;
}

/* ---------- 动效 ---------- */
@keyframes cs-pop {
  0% { transform: scale(0.86); opacity: 0; }
  60% { transform: scale(1.04); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.anim-pop {
  animation: cs-pop 360ms ease-out both;
}

@keyframes cs-up {
  from { transform: translateY(24rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.anim-up {
  animation: cs-up 320ms ease-out both;
}

@keyframes cs-shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-6deg); }
  75% { transform: rotate(6deg); }
}

.anim-shake {
  animation: cs-shake 260ms ease-in-out 2;
}
